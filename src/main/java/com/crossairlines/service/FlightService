package com.crossairlines.service;

import com.crossairlines.dto.FlightCreateRequest;
import com.crossairlines.dto.FlightDetailsDto;
import com.crossairlines.dto.FlightUpdateRequest;
import com.crossairlines.exception.FlightNotFoundException;
import com.crossairlines.mapper.FlightMapper;
import com.crossairlines.model.FlightDetails;
import com.crossairlines.repository.FlightRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.time.LocalDate;
import java.util.List;
import java.util.stream.Collectors;

@Service
@Transactional
public class FlightService {
    
    private final FlightRepository flightRepository;
    private final FlightMapper flightMapper;
    private final FlightValidationService validationService;
    
    @Autowired
    public FlightService(FlightRepository flightRepository, FlightMapper flightMapper, FlightValidationService validationService) {
        this.flightRepository = flightRepository;
        this.flightMapper = flightMapper;
        this.validationService = validationService;
    }
    
    public FlightDetailsDto createFlight(FlightCreateRequest request) {
        validationService.validateFlightSchedule(request.getDepartDate(), request.getArrivalDate(), request.getDepartTime(), request.getArrivalTime());
        validationService.validateCapacity(request.getSeatsAvailable());
        
        FlightDetails flight = flightMapper.mapCreateRequest(request);
        FlightDetails savedFlight = flightRepository.save(flight);
        return flightMapper.toDto(savedFlight);
    }
    
    public FlightDetailsDto updateFlight(Long flightId, FlightUpdateRequest request) {
        FlightDetails existingFlight = flightRepository.findById(flightId)
                .orElseThrow(() -> new FlightNotFoundException("Flight not found with id: " + flightId));
        
        if (request.getDepartDate() != null && request.getArrivalDate() != null && 
            request.getDepartTime() != null && request.getArrivalTime() != null) {
            validationService.validateFlightSchedule(request.getDepartDate(), request.getArrivalDate(), 
                    request.getDepartTime(), request.getArrivalTime());
        }
        
        if (request.getSeatsAvailable() != null) {
            validationService.validateCapacity(request.getSeatsAvailable());
        }
        
        FlightDetails updatedFlight = flightMapper.mapUpdateRequest(existingFlight, request);
        FlightDetails savedFlight = flightRepository.save(updatedFlight);
        return flightMapper.toDto(savedFlight);
    }
    
    public void deleteFlight(Long flightId) {
        if (!flightRepository.existsById(flightId)) {
            throw new FlightNotFoundException("Flight not found with id: " + flightId);
        }
        flightRepository.deleteById(flightId);
    }
    
    @Transactional(readOnly = true)
    public List<FlightDetailsDto> getAllFlights() {
        return flightRepository.findAll().stream()
                .map(flightMapper::toDto)
                .collect(Collectors.toList());
    }
    
    @Transactional(readOnly = true)
    public FlightDetailsDto getFlightById(Long flightId) {
        FlightDetails flight = flightRepository.findById(flightId)
                .orElseThrow(() -> new FlightNotFoundException("Flight not found with id: " + flightId));
        return flightMapper.toDto(flight);
    }
    
    @Transactional(readOnly = true)
    public List<FlightDetailsDto> searchFlights(String originCity, String destinationCity, LocalDate departDate) {
        List<FlightDetails> flights;
        
        if (departDate != null) {
            flights = flightRepository.findByOriginCityAndDestinationCityAndDepartDate(originCity, destinationCity, departDate);
        } else {
            flights = flightRepository.findByOriginCityAndDestinationCity(originCity, destinationCity);
        }
        
        return flights.stream()
                .map(flightMapper::toDto)
                .collect(Collectors.toList());
    }
    
    @Transactional(readOnly = true)
    public List<String> getOriginCities() {
        return flightRepository.findAllOriginCities();
    }
    
    @Transactional(readOnly = true)
    public List<String> getDestinationCities(String originCity) {
        return flightRepository.findDestinationCitiesByOriginCity(originCity);
    }
}